{
    "name": "inventory-reservations",
    "version": "0.1.0",
    "private": true,
    "description": "An append-only inventory reservation ledger, and the concurrency control it does not give you for free.",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "type-check": "tsc --noEmit",
        "build": "tsc -p tsconfig.build.json && cp src/postgres/migrate/*.sql dist/postgres/migrate/",
        "migrate": "npm run build && node dist/postgres/migrate/migrate-cli.js",
        "retention": "npm run build && node dist/postgres/idempotency/retention-cli.js",
        "expire-holds": "npm run build && node dist/postgres/holds/expire-cli.js",
        "reconcile": "npm run build && node dist/postgres/reconcile/reconcile-cli.js",
        "bench": "npm run build && node dist/postgres/bench/bench-cli.js && prettier --write docs/benchmarks",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prose": "node scripts/check-prose.mjs",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "verify": "npm run type-check && npm run lint && npm run format:check && npm run prose && npm run test:run",
        "prepare": "husky || true"
    },
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.23.1",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@fastify/rate-limit": "^11.2.1",
        "fastify": "^5.12.7",
        "pg": "^8.23.1"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css,html,sql}": [
            "prettier --write"
        ]
    }
}
