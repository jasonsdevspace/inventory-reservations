{
    "name": "inventory-reservations",
    "version": "0.5.0",
    "private": true,
    "description": "An append-only inventory reservation ledger, and the concurrency control it does not give you for free.",
    "type": "module",
    "engines": {
        "node": ">=24 <25",
        "npm": ">=11.14.0"
    },
    "scripts": {
        "type-check": "tsc --noEmit && tsc -p scripts",
        "build": "tsc -p tsconfig.build.json && cp src/postgres/migrate/*.sql dist/postgres/migrate/",
        "migrate": "npm run build && node dist/postgres/migrate/migrate-cli.js",
        "retention": "npm run build && node dist/postgres/idempotency/retention-cli.js",
        "expire-holds": "npm run build && node dist/postgres/holds/expire-cli.js",
        "reconcile": "npm run build && node dist/postgres/reconcile/reconcile-cli.js",
        "bench": "npm run build && node dist/postgres/bench/bench-cli.js && prettier --write docs/benchmarks",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prose": "check-prose",
        "node-check": "node scripts/check-node.mjs",
        "installs": "check-installs",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "verify": "npm run type-check && npm run lint && npm run format:check && npm run prose && npm run node-check && npm run installs && npm run test:run",
        "prepare": "husky || true"
    },
    "license": "MIT",
    "devDependencies": {
        "@jasonsdevspace/config": "0.1.0",
        "@jasonsdevspace/prose-check": "0.3.0",
        "@jasonsdevspace/repo-check": "0.1.0",
        "@types/node": "^24.19.2",
        "@types/pg": "^8.23.1",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.1",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.74.0",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "@fastify/rate-limit": "^11.2.2",
        "fastify": "^5.12.8",
        "pg": "^8.23.1"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css,html}": [
            "prettier --write"
        ]
    },
    "prettier": "@jasonsdevspace/config/prettier"
}
